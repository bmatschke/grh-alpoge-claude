    {
      "id": "LC5",
      "title": "Net gain with full-to-retained rank ratio and exceptional index",
      "status": "Faithful reconstruction with explicit signed-index bookkeeping",
      "claims": [
        "Local regular index uses full column dimension d, while slope normalization uses retained rank r>0.",
        "The loss is rho IO+(rho-1)Ta with rho=d/r, not merely IO.",
        "Exceptional primes use signed relative index and a separate nonnegative excess bound.",
        "For retained fraction >=1-delta, the source loss is IO/(1-delta)+delta Ta/(1-delta)."
      ],
      "remaining_inputs": [
        "Actual regular local-index estimates.",
        "Separate index contribution at the word type prime T_u."
      ],
