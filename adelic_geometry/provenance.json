    {
      "id": "AD3",
      "title": "Supported conjugate-pair splice preserves all five decorated-point conditions",
      "statement": "From supplied realizers h,h0 and the exact neighbor local-lattice/decorative equalities, g=(1-e)h+e*h0 with e=e_P+e_barP realizes the new point. The unitary epsilon=h^(-1)g is identity outside the conjugate pair. All five IsPtOf fields are checked; initial realization remains a premise.",
      "status": "derived_simplification",
      "mathematical_status": "proved_under_explicit_hypotheses",
      "depends_on": [
        "AD2"
      ],
      "proof_location": {
