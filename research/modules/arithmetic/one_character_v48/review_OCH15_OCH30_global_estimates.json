      ],
      "issue": "An arbitrary dual-number algebra map with a strictly local first component must not be assumed continuous solely from a formal presentation.",
      "resolution": "The final proof gives exact convergent Taylor division after a finite coefficient extension. It identifies every map from its finite coordinate values and proves continuity; OCH20 explicitly invokes it.",
      "status": "resolved_in_bound_proof"
    }
  ],
