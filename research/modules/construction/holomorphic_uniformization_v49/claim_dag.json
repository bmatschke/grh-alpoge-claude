  "component": "holomorphic_uniformization_v49",
  "nodes": [
    {
      "id": "HUF1",
      "classification": "B",
      "scope_note": "Every open base in every finite complex dimension; every source scheme open and regular function; exact vertical dual-number uniqueness in both directions.",
      "proof_sha256": "852d2d218a00937f26ab2b73103a1653db37b80c3b851c5dddb13c6ce5430b61"
    },
    {
      "id": "HUF2",
      "classification": "B",
      "scope_note": "The supplied universal object at the fixed base embedding; all original p/q including one zero, ordered type, actual line and proper relative family.",
      "proof_sha256": "846bac0a20abcfe3c1985b062f8b38074138334155de1a45a641612239284ae1"
    },
    {
      "id": "HUF3",
      "classification": "B",
      "scope_note": "The actual abelian-variety fiber and full exponential kernel; perfect integral form, original negative Weil commutator, all positive levels and every generator.",
      "proof_sha256": "8a2e955b5e34a520b181782fa2d6fa69f647a4c26aa542a4084d5dbe8c9c57c1"
    },
    {
      "id": "HUF4",
      "classification": "B",
      "scope_note": "Actual integral projective O_E lattice, no O_E basis assumption or finite-index replacement; exact positive J, ranks and trace identities.",
      "proof_sha256": "0db5a310c5381520d7a361169bd458bd397133ab396d49ea125d7075568a2e46"
    },
    {
      "id": "HUF5",
      "classification": "B",
      "scope_note": "All positive n,m simultaneously, projective integral quotient lifts, exact fixed root at A and t=f_lcm(M,A), both original markings.",
      "proof_sha256": "2bf8b19568e15d1118e4926fa3b86023d24a9f5372ff51e7e03dbf734d24e2a8"
    },
    {
      "id": "HUF6",
      "classification": "B",
      "scope_note": "Whole original reverse-point conclusion for every given y over the prescribed sigma, supplied Moduli retained.",
      "proof_sha256": "166fa4d59e47733ce910d1f61a29b38f371bc66c8a4fa34588ef66d89343702b"
    },
    {
      "id": "HUF7",
      "classification": "B",
      "scope_note": "Prescribed initial derivative and full lattice basis; one local jointly holomorphic exponential; continued lattice equals the entire kernel by degree-one proper covering.",
      "proof_sha256": "deb9a63178f47d7efc8f10800f3f1aa61b7d722c25c8b2b64d6aa3382b1c2be3"
    },
    {
      "id": "HUF8",
      "classification": "B",
      "scope_note": "Whole original local lift, preserving P(b0)=P0, same D prime and t, every positive Weil level on one neighborhood; no added InGenus hypothesis.",
      "proof_sha256": "45108564351ba9b5015905b1b3ae9c47a1202e1255614a332e55835d344d61a4"
    },
    {
      "id": "HUF9",
      "classification": "B",
      "scope_note": "Whole original finite-neighborhood coordinate interface, dimension f*p*q, every ordered type and every parameter dimension, including standalone rank zero.",
      "proof_sha256": "3d55ee5069106b5b60fdca5e228303cc3aa55aebe448d34ccd1a6d640e5a71e2"
    },
    {
      "id": "HUF10",
      "classification": "B",
      "scope_note": "Whole exact marked-exponential uniqueness; original half-level and A markings, integral congruence, all odd M>=3 including 3.",
      "proof_sha256": "4fd32521d1306d37d196fcc99321c1be3bec614e79a9295018f1ab89e2fd8529"
    },
    {
      "id": "HUF11",
      "classification": "B",
      "scope_note": "Actual moduli chart with the original dimension, no analytic representability axiom; zero-dimensional case included.",
      "proof_sha256": "b05a4e780c3622c1b95c08aa1be2b4f2a795e80a1bf0888e6511b42c7e79dfb1"
    },
    {
      "id": "HUF12",
      "classification": "B",
      "scope_note": "Whole original arbitrary-choice holomorphic point/exponential producer; no continuity assumption on chosen pointwise functions, every open B and every m.",
      "proof_sha256": "772fe0d2f35fa402991256d1c9be7aaa3c1046cffd1c7964748ac0991fee84f7"
    },
    {
      "id": "HUF13",
      "classification": "B",
      "scope_note": "Finite analytic component set for the supplied finite-type quasiprojective Moduli, not a compactness assertion.",
      "proof_sha256": "9f0705387cc3489b9fb9e2a4f6537b5d40f521aa1cd6a5c458eda2efa8dba158"
    },
    {
      "id": "HUF14",
      "classification": "B",
      "scope_note": "Exact marked integral isometry classes with the original two congruences; equal or disjoint nonempty open images, every moduli point covered.",
      "proof_sha256": "930b797bc9abd0e36f8e0d4121bde6bc5f39db845a4941eb4ddc0a1b483e5030"
    },
    {
      "id": "HUF15",
      "classification": "B",
      "scope_note": "One finite positive family and one set of total maps chosen before every period and every analytic base; original pointwise, onto, disj, hol and ex_diff fields.",
      "proof_sha256": "42b8eba8b75243787ea120bfc01b4d1d925cb4a8053d8dfcfd643d6a9e59ca04"
    },
    {
      "id": "HUF16",
      "classification": "B",
      "scope_note": "Literal fibre and lift fields; marking congruences transferred via exact mod-N surjectivity to the original target half-lattice and full A-lattice.",
      "proof_sha256": "fd26cda6db000a16fbd3359bad5bccc0d28ac8bffb537838ca1373f41a333886"
    },
    {
      "id": "HUF17",
      "classification": "B",
      "scope_note": "Every supplied symplectic basis/sign and normalizing h,tau; holomorphy and symmetry are derived, first-linear Hermitian sign checked.",
      "proof_sha256": "a22cad218f23b2aab6a351dc95d9ea269a5d592e2f70e4d028f9e2cf48fa2f48"
    },
    {
      "id": "HUF18",
      "classification": "B",
      "scope_note": "Constant original half-characteristics, exact primitive semicharacter and thetaChar series; line itself and rigidification matched, not just polarization.",
      "proof_sha256": "1228ef14378b70de003088b2626e809807cc56e9dc3604de055cbcd8a9520b9d"
    },
    {
      "id": "HUF19",
      "classification": "B",
      "scope_note": "Proper analytic family over any original open base; flat Hom line, constant h0=1 and rigidification yield global gluing without Stein or simply connected assumptions.",
      "proof_sha256": "3105799c584adbc7604c6684b12443eaa77ab94381dc84c8a1c62294dd601c76"
    },
    {
      "id": "HUF20",
      "classification": "B",
      "scope_note": "Whole original theta-family conclusion for arbitrary y/e with the original pointwise and holomorphy hypotheses; all five IsThetaFrame clauses, per-fiber algebraic GAGA section.",
      "proof_sha256": "eb5c2a877ac9292852258aa544aff86b76dd44ac67826f373f41abe2d3c40789"
    },
    {
      "id": "HUF21",
      "classification": "B",
      "scope_note": "Whole literal N1c and every FamilyUnif field, original fixed sigma/type, finite positive family and universal quantifier order; supplied Moduli and named foundations explicit.",
