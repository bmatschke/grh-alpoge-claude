    {
      "id": "LC2",
      "title": "Exact product tail-to-index bound and saturated refinement",
      "status": "Derived strengthening of the source index estimate",
      "claims": [
        "length(M/(N intersect a^tau M)) <= er[tau + S(product(1+m*kappa)-1)].",
        "The product is <= exp(m sum kappa), recovering tau+2S Sigma for Sigma<=1/2.",
        "For a saturated rank-r-prime sublattice the baseline is er-prime tau; the error retains ambient rank r.",
        "The actual theta-kernel expansion invokes the source selection conclusion, not this derived strengthening."
      ],
      "remaining_inputs": [
        "Joint rational-plane/exceptional-rank bounds and compatible lattice systems.",
        "Transport/saturation checks before using the stronger saturated estimate on the final automorphic reference lattices."
      ],
